# Copy to .env (or run `bun run setup`, which generates the secrets for you).

# --- Required ---------------------------------------------------------------
# Signs sessions. At least 32 characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Encrypts secret environment variables and repository tokens (AES-256-GCM).
# 32 random bytes in base64. Generate: openssl rand -base64 32
# Never lose or rotate it casually: existing secrets cannot be decrypted without it.
NELCOTA_ENCRYPTION_KEY=
# Public URL of the panel (used for auth cookies, CSRF origin and the webhook URL).
PUBLIC_URL=http://localhost:3000

# --- GitHub ------------------------------------------------------------------
# Shared secret of the GitHub webhook. Leave empty to disable automatic deploys.
GITHUB_WEBHOOK_SECRET=

# --- Storage -------------------------------------------------------------------
DATABASE_PATH=./data/nelcota.db
WORKSPACE_DIR=./data/workspaces

# --- Docker and proxy ---------------------------------------------------------
DOCKER_NETWORK=nelcota
# Adds Traefik routing labels to app containers. Enable when Traefik runs (docker compose).
TRAEFIK_ENABLED=false
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# --- Worker -------------------------------------------------------------------
WORKER_CONCURRENCY=2
BUILD_TIMEOUT_SECONDS=1200
HEALTH_CHECK_TIMEOUT_SECONDS=60
IMAGES_KEPT_PER_PROJECT=5
SCHEDULE_TIME_ZONE=America/Sao_Paulo

# --- Monitoring and retention ---------------------------------------------------
METRICS_INTERVAL_SECONDS=15
METRICS_RETENTION_HOURS=48
RUNTIME_LOG_RETENTION_LINES=5000
DEPLOYMENT_LOG_RETENTION_DAYS=30

LOG_LEVEL=info
PORT=3000

# --- Docker Compose only ---------------------------------------------------------
# Hostname of the panel behind Traefik and the e-mail for Let's Encrypt.
PANEL_DOMAIN=deploy.example.com
ACME_EMAIL=admin@example.com
# Group id that owns /var/run/docker.sock on the host: stat -c %g /var/run/docker.sock
DOCKER_GID=999
