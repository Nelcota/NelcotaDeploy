{
  "name": "nelcota-deploy",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bun run src/config/setup-env.ts",
    "dev": "bun run db:migrate && bun --bun vite dev",
    "worker": "bun run src/worker/main.ts",
    "build": "bun --bun vite build",
    "start": "bun run src/web/serve.ts",
    "mcp": "bun run src/mcp/main.ts",
    "admin:create": "bun run src/auth/bootstrap-admin.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "package-size": "bun run lint/check-package-size.ts",
    "test": "bun test --path-ignore-patterns='**/*.integration.test.ts'",
    "ui:review": "bun run src/ui-review/main.ts",
    "test:docker": "bun test integration.test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run package-size && bun run test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@octokit/webhooks": "14.2.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "1.7.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cronstrue": "3.38.0",
    "drizzle-orm": "0.45.4",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.64.0",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "ssh2": "1.17.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "packageManager": "bun@1.4.4"
}
