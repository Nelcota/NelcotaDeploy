{
  "name": "nelcota-deploy",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bun run src/config/setup-env.ts",
    "dev": "bun run db:migrate && bun --bun vite dev",
    "worker": "bun run src/worker/main.ts",
    "build": "bun --bun vite build",
    "start": "bun run src/web/serve.ts",
    "mcp": "bun run src/mcp/main.ts",
    "admin:create": "bun run src/auth/bootstrap-admin.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "bun test",
    "test:docker": "DOCKER_INTEGRATION=1 bun test src/worker/deploy.integration.test.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@octokit/webhooks": "14.2.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.2",
    "@tanstack/react-table": "9.3.1",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.57.0",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "packageManager": "bun@1.4.2"
}
