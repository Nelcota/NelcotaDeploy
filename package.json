{
  "name": "meu-projeto",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "bun test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
