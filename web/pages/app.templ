package pages

import (
	"github.com/Nelcota/NelcotaDeploy/web/i18n"
	"strings"

	"github.com/Nelcota/NelcotaDeploy/internal/service"
	"github.com/Nelcota/NelcotaDeploy/web/ui"
)

// AppContext is shared by the app's tabs.
type AppContext struct {
	App        service.App
	ServerName string
	Tab        string
}

func repoName(url string) string {
	return strings.TrimPrefix(url, "https://github.com/")
}

type appTab struct{ key, label, icon string }

var appTabs = []appTab{{"overview", "Overview", "activity"}, {"deployments", "History", "history"}, {"logs", "Logs", "terminal"}, {"settings", "Settings", "sliders-horizontal"}}

func tabHref(app, key string) string {
	if key == "overview" {
		return "/apps/" + app
	}
	return "/apps/" + app + "/" + key
}

// AppHeaderLogo is the logo beside the app's name; uploads redraw it.
templ AppHeaderLogo(a service.App) {
	<span id="app-header-logo" class="contents">
		@AppLogo(a, "size-14 rounded-2xl text-xl")
	</span>
}

// AppLayout renders the app header (with optional actions) and tab navigation around tab content.
templ AppLayout(s Shell, c AppContext, actions templ.Component) {
	@App(s) {
		<nav aria-label={ i18n.T(ctx, "Breadcrumb") } class="mb-2 text-sm text-muted-foreground">
			<ol class="flex items-center gap-1">
				<li><a href="/apps" class="hover:text-foreground">{ i18n.T(ctx, "Apps") }</a></li>
				<li aria-hidden="true">
					@ui.Icon("chevron-right", "size-3.5")
				</li>
				<li aria-current="page" class="truncate text-foreground">{ c.App.Name }</li>
			</ol>
		</nav>
		<div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
			<div class="flex min-w-0 items-start gap-4">
				@AppHeaderLogo(c.App)
				<div class="min-w-0">
					<h1 class="page-title flex flex-wrap items-center gap-2">
						{ c.App.Name }
						if c.App.Config.Stopped {
							<span class="status" data-tone="muted">{ i18n.T(ctx, "Stopped") }</span>
						}
					</h1>
					<p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
						<a class="inline-flex items-center gap-1 hover:text-foreground" href={ templ.SafeURL(c.App.Repository) } rel="noopener noreferrer" target="_blank">
							{ repoName(c.App.Repository) }
							@ui.Icon("external-link", "size-3.5")
							<span class="sr-only">{ i18n.T(ctx, "(opens GitHub)") }</span>
						</a>
						<span class="inline-flex items-center gap-1">
							@ui.Icon("git-branch", "size-3.5")
							{ c.App.Branch }
						</span>
						<span class="inline-flex items-center gap-1">
							@ui.Icon("server", "size-3.5")
							{ c.ServerName }
						</span>
						for _, d := range c.App.Config.Domains {
							<a class="inline-flex items-center gap-1 hover:text-foreground" href={ templ.SafeURL("https://" + d) } rel="noopener noreferrer" target="_blank">
								@ui.Icon("globe", "size-3.5")
								{ d }
							</a>
						}
					</p>
				</div>
			</div>
			if actions != nil {
				<div class="flex flex-wrap gap-2">
					@actions
				</div>
			}
		</div>
		<nav aria-label={ i18n.T(ctx, "App sections") } class="mb-6 overflow-x-auto border-b">
			<ul class="flex gap-1">
				for _, t := range appTabs {
					<li>
						<a
							href={ templ.SafeURL(tabHref(c.App.ID, t.key)) }
							class="-mb-px inline-flex items-center gap-2 border-b-2 border-transparent px-3 py-2 text-sm font-medium whitespace-nowrap text-muted-foreground hover:text-foreground aria-[current=page]:border-primary aria-[current=page]:text-foreground"
							if t.key == c.Tab {
								aria-current="page"
							}
						>
							@ui.Icon(t.icon, "")
							{ i18n.T(ctx, t.label) }
						</a>
					</li>
				}
			</ul>
		</nav>
		{ children... }
	}
}
