package pages

import (
	"github.com/Nelcota/NelcotaDeploy/internal/service"
	"github.com/Nelcota/NelcotaDeploy/web/i18n"
	"github.com/Nelcota/NelcotaDeploy/web/ui"
)

// LogsView selects build logs for one deployment or the app's runtime logs.
type LogsView struct {
	Deployments []service.Deployment
	Selected    service.Deployment
	Runtime     bool
	Err         string
}

func (v LogsView) fileName(app string) string {
	if v.Runtime {
		return app + "-runtime.log"
	}
	return app + "-" + ui.ShortSHA(v.Selected.SHA) + "-" + v.Selected.ID + ".log"
}

// finished reports whether the selected build log is complete.
func (v LogsView) finished() bool {
	return !v.Runtime && v.Selected.ID != "" && !ui.Active(v.Selected.Status)
}

templ Logs(s Shell, c AppContext, v LogsView) {
	@AppLayout(s, c, nil) {
		<div class="grid gap-3">
			<form method="get" action={ templ.SafeURL("/apps/" + c.App.ID + "/logs") } class="flex flex-wrap items-end gap-3">
				<div class="grid gap-1.5">
					<label class="label" for="log-source">{ i18n.T(ctx, "Source") }</label>
					<select id="log-source" name="deployment" class="select max-w-full" data-on:change="el.form.submit()">
						<option
							value="runtime"
							if v.Runtime {
								selected
							}
						>{ i18n.T(ctx, "Runtime logs (live)") }</option>
						for _, d := range v.Deployments {
							<option
								value={ d.ID }
								if !v.Runtime && d.ID == v.Selected.ID {
									selected
								}
							>{ i18n.Tf(ctx, "Build %s", ui.ShortSHA(d.SHA)) } · { i18n.T(ctx, ui.StatusLabel(d.Status)) } · { i18n.T(ctx, ui.Ago(d.QueuedAt)) }</option>
						}
					</select>
				</div>
				<noscript><button type="submit" class="btn" data-variant="outline">{ i18n.T(ctx, "Show") }</button></noscript>
				// The source list already names the build; this line adds what it
				// can't: the live status, the commit message, and how long it took.
				<div class="flex min-h-9 min-w-0 basis-full flex-wrap items-center gap-x-3 gap-y-1 text-sm sm:basis-0 sm:flex-1">
					if !v.Runtime {
						@ui.Pill(ui.Tone(v.Selected.Status), ui.StatusLabel(v.Selected.Status), templ.Attributes{"id": "log-status", "data-status": v.Selected.Status})
						if v.Selected.Message != "" {
							<span class="min-w-0 truncate text-muted-foreground" title={ v.Selected.Message }>{ v.Selected.Message }</span>
						}
						if v.Selected.StartedAt > 0 && v.finished() {
							<span class="flex shrink-0 items-center gap-1 text-muted-foreground tabular-nums" title={ i18n.T(ctx, "Duration") }>
								@ui.Icon("clock", "size-3.5")
								{ ui.Span(v.Selected.StartedAt, v.Selected.FinishedAt) }
							</span>
						}
					}
					<span id="log-conn" class="conn" data-state="connecting" role="status" hidden?={ v.finished() }>{ i18n.T(ctx, "Connecting…") }</span>
				</div>
			</form>
			if v.Err != "" {
				@ui.ErrorState("Logs unavailable", v.Err)
			} else {
				<div class="flex flex-wrap items-center gap-2" role="toolbar" aria-label={ i18n.T(ctx, "Log controls") } aria-controls="terminal">
					// Phones give the search its own full-width line.
					<div class="flex w-full min-w-0 items-center gap-1 sm:w-auto sm:max-w-sm sm:flex-1">
						<label for="log-search" class="sr-only">{ i18n.T(ctx, "Search logs") }</label>
						<input id="log-search" type="search" class="input h-8 min-w-0 flex-1" placeholder={ i18n.T(ctx, "Search logs") } autocomplete="off" spellcheck="false" aria-describedby="log-matches"/>
						@ui.Button("outline", "icon-sm", templ.Attributes{"data-log": "prev", "aria-label": i18n.T(ctx, "Previous match")}) {
							@ui.Icon("chevron-right", "rotate-180")
						}
						@ui.Button("outline", "icon-sm", templ.Attributes{"data-log": "next", "aria-label": i18n.T(ctx, "Next match")}) {
							@ui.Icon("chevron-right", "")
						}
					</div>
					<span id="log-matches" class="text-xs whitespace-nowrap text-muted-foreground tabular-nums empty:hidden" aria-live="polite"></span>
					<div class="flex flex-wrap items-center gap-1 sm:ms-auto">
						// A finished build doesn't grow, so following and pausing are hidden
						// (kept in the page because logs.js drives them).
						@ui.Button("outline", "sm", templ.Attributes{"data-log": "pause", "aria-pressed": "false", "hidden": v.finished()}) {
							@ui.Icon("pause", "")
							<span>{ i18n.T(ctx, "Pause") }</span>
						}
						@ui.Button("outline", "sm", templ.Attributes{"data-log": "follow", "aria-pressed": "true", "hidden": v.finished()}) {
							@ui.Icon("arrow-down-to-line", "")
							<span>{ i18n.T(ctx, "Follow") }</span>
						}
						@ui.Button("outline", "sm", templ.Attributes{"data-log": "download"}) {
							@ui.Icon("download", "")
							<span>{ i18n.T(ctx, "Download") }</span>
						}
						if v.Runtime {
							@ui.Button("ghost", "sm", templ.Attributes{"data-log": "clear"}) {
								{ i18n.T(ctx, "Clear") }
							}
						}
					</div>
				</div>
				<div
					id="terminal"
					class="log-view"
					role="log"
					aria-label={ i18n.T(ctx, "Log output") }
					if v.Runtime {
						data-mode="runtime"
						data-topic={ "app/" + c.App.ID }
					} else {
						data-mode="build"
						data-topic={ "deploy/" + v.Selected.ID }
						data-deployment={ v.Selected.ID }
						data-status={ v.Selected.Status }
					}
					data-file={ v.fileName(c.App.Name) }
				></div>
				<p id="log-held" class="hidden text-xs text-warning" role="status"></p>
				<p class="text-xs text-muted-foreground">
					if v.Runtime {
						{ i18n.T(ctx, "Runtime logs are streamed live and not stored.") }
					} else {
						{ i18n.T(ctx, "Logs of the last 50 deployments are kept. Secrets are masked.") }
					}
				</p>
			}
		</div>
	}
}
