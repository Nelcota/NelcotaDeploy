package ui

import "github.com/Nelcota/NelcotaDeploy/web/i18n"

// Button renders a Basecoat button. variant: "", secondary, outline, ghost, destructive, link.
// size: "", xs, sm, lg, icon, icon-sm.
templ Button(variant, size string, attrs templ.Attributes) {
	<button
		type="button"
		class="btn"
		if variant != "" {
			data-variant={ variant }
		}
		if size != "" {
			data-size={ size }
		}
		{ attrs... }
	>
		{ children... }
	</button>
}

// LinkButton renders a link styled as a button.
templ LinkButton(href templ.SafeURL, variant, size string, attrs templ.Attributes) {
	<a
		href={ href }
		class="btn"
		if variant != "" {
			data-variant={ variant }
		}
		if size != "" {
			data-size={ size }
		}
		{ attrs... }
	>
		{ children... }
	</a>
}

// Status renders a colored status pill with a text label (never color alone).
templ Status(value string) {
	@Pill(Tone(value), StatusLabel(value), templ.Attributes{"data-status": value})
}

// Pill renders a status pill in a tone (success, danger, warning, progress,
// info, muted) with a translated label and optional attributes.
templ Pill(tone, label string, attrs templ.Attributes) {
	<span class="status" data-tone={ tone } { attrs... }>{ i18n.T(ctx, label) }</span>
}

// Badge renders a neutral Basecoat badge.
templ Badge(variant, text string) {
	<span
		class="badge"
		if variant != "" {
			data-variant={ variant }
		}
	>{ i18n.T(ctx, text) }</span>
}

// Field wraps a control with its label, hint, and error. The control must use id.
templ Field(label, id, hint, err string) {
	<div class="grid content-start gap-1.5" data-field={ id }>
		<label class="label" for={ id }>{ i18n.T(ctx, label) }</label>
		{ children... }
		if hint != "" {
			<p id={ id + "-hint" } class="text-xs text-muted-foreground">{ i18n.T(ctx, hint) }</p>
		}
		<p id={ id + "-error" } class="text-xs text-destructive" role="alert">{ i18n.T(ctx, err) }</p>
	</div>
}

// Card renders a titled card. Omit title for a plain panel.
templ Card(title, description string) {
	@Panel(CardProps{Title: title, Description: description}) {
		{ children... }
	}
}

// CardProps configures Panel. Title and Description are translated.
type CardProps struct {
	ID, Class   string
	Title       string
	Description string
	// TitleExtra follows the title text inside the heading, such as a count or a status.
	TitleExtra templ.Component
	// Header replaces the description with richer content.
	Header templ.Component
	// Action fills the top-right header slot.
	Action templ.Component
	// HeaderOnly leaves out the body for cards that are all header.
	HeaderOnly bool
}

func (p CardProps) titleID() string {
	if p.ID == "" {
		return ""
	}
	return p.ID + "-title"
}

// Panel renders a card with an optional id, header content, and action slot.
templ Panel(p CardProps) {
	<section
		if p.ID != "" {
			id={ p.ID }
		}
		class={ "card", templ.KV(p.Class, p.Class != "") }
		if p.Title != "" && p.ID != "" {
			aria-labelledby={ p.titleID() }
		}
	>
		if p.Title != "" {
			<header>
				<h2
					if p.ID != "" {
						id={ p.titleID() }
					}
				>
					{ i18n.T(ctx, p.Title) }
					if p.TitleExtra != nil {
						@p.TitleExtra
					}
				</h2>
				if p.Header != nil {
					@p.Header
				} else if p.Description != "" {
					<p>{ i18n.T(ctx, p.Description) }</p>
				}
				if p.Action != nil {
					<div class="card-action">
						@p.Action
					</div>
				}
			</header>
		}
		if !p.HeaderOnly {
			<section>
				{ children... }
			</section>
		}
	</section>
}

// Disclosure is a <details> block with a rotating chevron instead of the
// native marker. extra follows the summary text, such as a status.
templ Disclosure(id, summary string, open bool, class string, extra templ.Component) {
	<details
		if id != "" {
			id={ id }
		}
		class={ "disclosure", templ.KV(class, class != "") }
		open?={ open }
	>
		<summary>
			@Icon("chevron-right", "disclosure-chevron")
			<span>{ i18n.T(ctx, summary) }</span>
			if extra != nil {
				@extra
			}
		</summary>
		<div class="disclosure-body">
			{ children... }
		</div>
	</details>
}

// Tab is one link of a TabNav.
type Tab struct {
	Href, Icon, Label string
	Current           bool
}

// TabNav renders underlined section tabs. They scroll sideways on narrow
// screens with faded edges (app.js marks the overflowing sides); children
// sit at the end of the row.
templ TabNav(label string, tabs []Tab, class string) {
	<div class={ "tabs-row", templ.KV(class, class != "") }>
		<nav aria-label={ i18n.T(ctx, label) } class="tabs-nav" data-tabs>
			<ul class="flex gap-1">
				for _, t := range tabs {
					<li>
						<a
							href={ templ.SafeURL(t.Href) }
							class="tab-link"
							if t.Current {
								aria-current="page"
							}
						>
							@Icon(t.Icon, "")
							{ i18n.T(ctx, t.Label) }
						</a>
					</li>
				}
			</ul>
		</nav>
		{ children... }
	</div>
}

// Table wraps a table so it scrolls horizontally inside narrow screens.
templ Table(label string) {
	<div class="relative min-w-0 max-w-full overflow-x-auto rounded-xl border" role="region" aria-label={ i18n.T(ctx, label) } tabindex="0">
		<table class="table">
			{ children... }
		</table>
	</div>
}

// Empty renders an empty state with optional actions as children.
templ Empty(icon, title, body string) {
	<div class="empty rounded-xl border border-dashed">
		<header>
			<figure>
				@Icon(icon, "size-5")
			</figure>
			<h3>{ i18n.T(ctx, title) }</h3>
			if body != "" {
				<p>{ i18n.T(ctx, body) }</p>
			}
		</header>
		<footer class="flex flex-wrap justify-center gap-2">
			{ children... }
		</footer>
	</div>
}

// Loading renders a polite loading indicator.
templ Loading(label string) {
	<div class="flex items-center gap-2 text-sm text-muted-foreground" role="status">
		@Icon("loader-circle", "size-4 animate-spin")
		<span>{ i18n.T(ctx, label) }</span>
	</div>
}

// ErrorState renders an inline error with optional retry children.
templ ErrorState(title, message string) {
	<div class="alert" data-variant="destructive" role="alert">
		@Icon("circle-alert", "")
		<h2>{ i18n.T(ctx, title) }</h2>
		<section>
			<p>{ i18n.T(ctx, message) }</p>
			{ children... }
		</section>
	</div>
}

// Notice renders a neutral informational alert.
templ Notice(icon, title string) {
	<div class="alert">
		@Icon(icon, "")
		<h2>{ i18n.T(ctx, title) }</h2>
		<section>
			{ children... }
		</section>
	</div>
}

// Toast is appended to #toaster by server responses. app.js removes it after
// a few seconds, pausing while it is hovered or focused.
templ Toast(tone, message string) {
	<div
		class="toast"
		data-tone={ tone }
		if tone == "danger" {
			role="alert"
		} else {
			role="status"
		}
		data-toast
	>
		switch tone {
			case "danger":
				@Icon("circle-alert", "mt-0.5 size-4 shrink-0")
			case "success":
				@Icon("circle-check", "mt-0.5 size-4 shrink-0")
			default:
				@Icon("info", "mt-0.5 size-4 shrink-0")
		}
		<p class="flex-1" data-toast-message>{ i18n.T(ctx, message) }</p>
		<button type="button" class="btn" data-variant="ghost" data-size="icon-xs" aria-label={ i18n.T(ctx, "Dismiss notification") } data-toast-dismiss>
			@Icon("x", "")
		</button>
	</div>
}

// ToastTemplates lets scripts build toasts identical to the server's.
templ ToastTemplates() {
	for _, tone := range []string{"success", "info", "danger"} {
		<template data-toast-template={ tone }>
			@Toast(tone, "")
		</template>
	}
}

// ConfirmDialog asks for explicit confirmation before running action.
// Children add content such as a type-to-confirm field. Dialogs are excluded from
// morphing so live re-renders never close one the user has open.
templ ConfirmDialog(id, title, body, confirmLabel, action string, destructive bool) {
	<dialog id={ id } class="dialog" aria-labelledby={ id + "-title" } aria-describedby={ id + "-body" } data-on:click="evt.target === el && el.close()" data-ignore-morph>
		<div class="w-[calc(100%-2rem)] max-w-md gap-4 rounded-2xl border bg-background p-6 shadow-lg">
			<header class="gap-1.5">
				<h2 id={ id + "-title" } class="text-lg font-semibold">{ i18n.T(ctx, title) }</h2>
				<p id={ id + "-body" } class="text-sm text-muted-foreground">{ i18n.T(ctx, body) }</p>
			</header>
			{ children... }
			<footer class="gap-2">
				<button type="button" class="btn" data-variant="outline" data-on:click="el.closest('dialog').close()">{ i18n.T(ctx, "Go back") }</button>
				<button
					type="button"
					class="btn"
					if destructive {
						data-variant="destructive"
					}
					data-confirm
					data-on:click={ action + "; el.closest('dialog').close()" }
				>{ i18n.T(ctx, confirmLabel) }</button>
			</footer>
		</div>
	</dialog>
}

// Dialog renders a general modal with a close button.
templ Dialog(id, title, description string) {
	<dialog id={ id } class="dialog" aria-labelledby={ id + "-title" } data-on:click="evt.target === el && el.close()" data-ignore-morph>
		<div class="w-[calc(100%-2rem)] max-w-lg gap-4 overflow-y-auto rounded-2xl border bg-background p-6 shadow-lg">
			<header class="gap-1.5 pr-8">
				<h2 id={ id + "-title" } class="text-lg font-semibold">{ i18n.T(ctx, title) }</h2>
				if description != "" {
					<p class="text-sm text-muted-foreground">{ i18n.T(ctx, description) }</p>
				}
			</header>
			{ children... }
			<button type="button" class="btn top-3 right-3" data-variant="ghost" data-size="icon-sm" aria-label={ i18n.T(ctx, "Close") } data-on:click="el.closest('dialog').close()">
				@Icon("x", "")
			</button>
		</div>
	</dialog>
}

// Kbd renders a keyboard hint.
templ Kbd(text string) {
	<kbd class="kbd">{ i18n.T(ctx, text) }</kbd>
}

// Copy renders a button that copies the text of the element with target id.
templ Copy(target, label string) {
	<button type="button" class="btn" data-variant="outline" data-size="sm" data-copy={ target }>
		@Icon("copy", "")
		{ i18n.T(ctx, label) }
	</button>
}

// Redirect navigates after a Datastar response.
templ Redirect(url string) {
	<script data-redirect={ url }>location.assign(document.currentScript.dataset.redirect)</script>
}

// Run executes a Datastar expression once after a server response, for example
// to reset a form or close a dialog only when an action succeeded.
templ Run(expr string) {
	<div hidden data-init={ expr + "; el.remove()" }></div>
}
